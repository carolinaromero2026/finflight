# Bucket (en Railway: usa referencias a las variables del bucket, ver README)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
S3_PREFIX=vuelos
# Solo si el proveedor falla con "auto":
# S3_ADDRESSING_STYLE=path

# Collector
# MODO: tiles | global
MODO=tiles
MAX_REQUESTS=200
PAUSA_S=0.3
RUN_TIMEOUT_S=240
INCLUIR_EN_TIERRA=0

# Compactación
BORRAR_ORIGINALES=1
